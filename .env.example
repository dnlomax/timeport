REACTOR_API_KEY=rk_your_api_key_here

# Google Cloud key with Street View Static API + Geocoding API enabled
GOOGLE_MAPS_API_KEY=

# Period restyle — one of the two. Vertex wins if both are set.
# AI Studio key (aistudio.google.com/apikey); image models need a paid tier.
GEMINI_API_KEY=
# Vertex AI express-mode key; billed to the Cloud project, so trial credit applies.
VERTEX_API_KEY=
# Optional regional Vertex endpoint, e.g. europe-west4. Defaults to global.
# VERTEX_LOCATION=
# Optional image model override. Defaults to gemini-2.5-flash-image.
# GEMINI_IMAGE_MODEL=

# Optional — Reactor API base URL. Defaults to https://api.reactor.inc
# NEXT_PUBLIC_REACTOR_API_URL=
